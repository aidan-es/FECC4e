<!-- Generated by cargo-about from fecc_gui/licences/about.hbs and fonts.hbs. Run `cargo make licences` to update. -->
<html lang="en-GB">
<head>
    <meta property="og:site_name" content="FE Character Creator" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Licences of the third-party Rust crates used by FE Character Creator, 4th Edition.">
    <title>FECC4e Third-Party Licences</title>
    <link rel="stylesheet" href="../style.css">
    <style>
        pre { white-space: pre-wrap; max-height: 20rem; overflow-y: auto; }
    </style>
</head>
<body>
    <main>
        <h1>Third-Party Licences</h1>
        <p>
            FE Character Creator, 4th Edition is licensed under the
            <a href="https://www.gnu.org/licenses/agpl-3.0.html">GNU AGPLv3</a>, excluding art assets.
            It is built with the Rust crates and fonts below, which are used under these licences.
        </p>

        <h2>Overview</h2>
        <ul>
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
            <li><a href="#fonts">Fonts</a> (4)</li>
        </ul>

        {{#each licenses}}
        {{#if first_of_kind}}
        <h2 id="{{id}}">{{name}}</h2>
        {{/if}}
        <p>Used by:
            {{#each used_by}}
            <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
            {{/each}}
        </p>
        <pre>{{text}}</pre>
        {{/each}}

{{! Unindented, as Handlebars indents every line of a partial to match, including inside <pre> }}
{{> fonts}}
    </main>
</body>
</html>
